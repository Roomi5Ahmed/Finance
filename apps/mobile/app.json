{
  "expo": {
    "name": "Smart Finance Tracker",
    "slug": "smart-finance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartfinance",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#01472e",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roomiahmed.smartfinance"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01472e",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.roomiahmed.smartfinance"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#01472e"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ccd5ae"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
