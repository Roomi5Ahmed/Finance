# Environment variables for the mobile app
# Copy to .env and fill in values

# Supabase project (same as web app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Next.js API base URL (for Section 6 route handlers)
# For local dev: http://YOUR_LOCAL_IP:3000 (not localhost — must be reachable from device)
# For prod: https://your-deployed-app.vercel.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
